---
import Layout from '../../layouts/Layout.astro';
import { navHref, isLang } from '../../i18n/utils';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const L = isLang(lang) ? lang : 'zh';
const u = t(L);
const homeHref = navHref(L, '/');
---

<!--
  「论文成果 / Publications」页面已整体下线：
  · 导航菜单（页眉 + 页脚）已移除入口
  · 站内搜索索引已移除论文条目
  · 本文件保留仅为兼容旧链接：访问 /publications 会自动跳回首页，不再渲染任何论文内容
  · 论文数据（src/content/papers/）与后台「论文成果」栏目均保留，随时可恢复

  恢复方法：用 git 历史中本文件改动前的版本覆盖回来，
            并在 src/i18n/ui.ts 的 navItems 中加回 publications 条目。
-->
<Layout lang={L} title={u.publications_title} active="home">
  <section class="section">
    <div class="container">
      <p>
        {L === 'zh'
          ? '「论文成果」页面已下线，正在返回首页…'
          : 'The Publications page has been removed. Redirecting to the homepage…'}
      </p>
      <p><a href={homeHref}>{L === 'zh' ? '返回首页' : 'Back to home'}</a></p>
    </div>
  </section>
  <script is:inline define:vars={{ homeHref }}>
    location.replace(homeHref);
  </script>
</Layout>

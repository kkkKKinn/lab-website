---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { lab, t, heroImages, galleryImages } from '../../i18n/ui';
import { navHref, isLang, asset } from '../../i18n/utils';
import PeopleCard from '../../components/PeopleCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import NewsCard from '../../components/NewsCard.astro';
import PartnerCard from '../../components/PartnerCard.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'zh' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const L = isLang(lang) ? lang : 'zh';
const isZh = L === 'zh';
const u = t(L);

const [people, papers, projects, equipment, partners, news] = await Promise.all([
  getCollection('people'),
  getCollection('papers'),
  getCollection('projects'),
  getCollection('equipment'),
  getCollection('partners'),
  getCollection('news'),
]);

people.sort((a, b) => a.data.order - b.data.order);
projects.sort((a, b) => a.data.order - b.data.order);
partners.sort((a, b) => a.data.order - b.data.order);
news.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPeople = people.slice(0, 4);
const ongoingProjects = projects.filter((p) => p.data.status === 'ongoing').slice(0, 3);
const recentNews = news.slice(0, 3);
const labName = isZh ? lab.name_zh : lab.name_en;
const labOrg = isZh ? lab.org_zh : lab.org_en;

// —— 站内搜索索引（按当前语言生成） ——
const typeLabel = (zh: string, en: string) => (isZh ? zh : en);
const searchIndex = [
  ...people.map((p) => ({
    typeLabel: typeLabel('成员', 'People'),
    title: isZh ? p.data.name_zh : p.data.name_en,
    desc: isZh ? p.data.title_zh : p.data.title_en,
    url: navHref(L, '/people'),
  })),
  ...papers.map((p) => ({
    typeLabel: typeLabel('论文', 'Publications'),
    title: isZh ? p.data.title_zh : p.data.title_en,
    desc: `${p.data.authors} · ${p.data.year} · ${p.data.venue}`,
    url: navHref(L, '/publications'),
  })),
  ...projects.map((p) => ({
    typeLabel: typeLabel('项目', 'Projects'),
    title: isZh ? p.data.title_zh : p.data.title_en,
    desc: isZh ? p.data.summary_zh : p.data.summary_en,
    url: navHref(L, '/research'),
  })),
  ...equipment.map((e) => ({
    typeLabel: typeLabel('设备', 'Equipment'),
    title: isZh ? e.data.name_zh : e.data.name_en,
    desc: isZh ? e.data.desc_zh : e.data.desc_en,
    url: navHref(L, '/equipment'),
  })),
  ...partners.map((p) => ({
    typeLabel: typeLabel('合作', 'Partners'),
    title: isZh ? p.data.name_zh : p.data.name_en,
    desc: isZh ? p.data.desc_zh : p.data.desc_en,
    url: navHref(L, '/partners'),
  })),
  ...news.map((n) => {
    const slug = n.id.replace(/\.md$/, '');
    return {
      typeLabel: typeLabel('新闻', 'News'),
      title: isZh ? n.data.title_zh : n.data.title_en,
      desc: isZh ? n.data.summary_zh : n.data.summary_en,
      url: navHref(L, `/news/${slug}`),
    };
  }),
];
---

<Layout lang={L} title={labName} active="home">
  <!-- ===== Hero ===== -->
  <section class="hero">
{heroImages.length > 0 && (
      <div class="hero__bg" aria-hidden="true">
        {heroImages.map((src, i) => (
          <div
            class:list={['hero__slide', { 'is-active': i === 0 }]}
            style={`background-image:url('${asset(src)}')`}
          />
        ))}
      </div>
    )}
    <div class="container">
      <div class="hero__inner">
        <div class="hero__org">{labOrg}</div>
        <h1 class="hero__title">{u.home_hero_title}</h1>
        <p class="hero__sub">{u.home_hero_sub}</p>
        <div class="hero__actions">
          <a href={navHref(L, '/research')} class="btn btn--primary">{u.home_hero_cta}</a>
          <a href={navHref(L, '/people')} class="btn btn--ghost hero__ghost">{u.home_hero_cta2}</a>
        </div>
        <div class="hero__stats">
          <div class="hero__stat"><span class="hero__stat-num">{papers.length}+</span><span class="hero__stat-label">{isZh ? '发表论文' : 'Publications'}</span></div>
          <div class="hero__stat"><span class="hero__stat-num">{projects.length}</span><span class="hero__stat-label">{isZh ? '在研项目' : 'Projects'}</span></div>
          <div class="hero__stat"><span class="hero__stat-num">{people.length}</span><span class="hero__stat-label">{isZh ? '团队成员' : 'Members'}</span></div>
          <div class="hero__stat"><span class="hero__stat-num">{partners.length}+</span><span class="hero__stat-label">{isZh ? '合作单位' : 'Partners'}</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 实验室简介 ===== -->
  <section class="section" data-reveal>
    <div class="container about">
      <div class="about__head">
        <div class="section__kicker">{labName}</div>
        <h2 class="section__title">{u.home_welcome_title}</h2>
        <p class="section__desc">{u.home_welcome_body}</p>
      </div>
      <div class="about__body">
        <form class="site-search" role="search" autocomplete="off" onsubmit="return false">
          <svg class="site-search__icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
            <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <input
            type="search"
            id="siteSearchInput"
            class="site-search__input"
            placeholder={isZh ? '搜索成员、论文、项目、新闻…' : 'Search members, papers, projects, news…'}
            aria-label={isZh ? '站内搜索' : 'Site search'}
            data-empty={isZh ? '未找到相关结果' : 'No results found'}
          />
          <ul class="site-search__results" id="siteSearchResults" hidden></ul>
        </form>
        <script type="application/json" id="searchIndexData" set:html={JSON.stringify(searchIndex)}></script>
      </div>
    </div>
  </section>

  <!-- ===== 实验室掠影 ===== -->
  {galleryImages.length > 0 && (
    <section class="section section--alt" data-reveal>
      <div class="container">
        <div class="section__head">
          <div class="section__head__text">
            <div class="section__kicker">Gallery</div>
            <h2 class="section__title">{u.home_gallery_title}</h2>
            <p class="section__desc">{u.home_gallery_desc}</p>
          </div>
        </div>
        <PhotoGallery images={galleryImages} lang={L} />
      </div>
    </section>
  )}

  <!-- ===== 研究方向 ===== -->
  <section class="section" data-reveal>
    <div class="container">
      <div class="section__head">
        <div class="section__head__text">
          <div class="section__kicker">Research</div>
          <h2 class="section__title">{u.home_research_title}</h2>
          <p class="section__desc">{u.home_research_desc}</p>
        </div>
        <a href={navHref(L, '/research')} class="btn btn--ghost">{u.viewAll}</a>
      </div>
      <div class="grid grid--3">
        {ongoingProjects.map((p) => <ProjectCard project={p} lang={L} />)}
      </div>
    </div>
  </section>

  <!-- ===== 新闻动态 ===== -->
  <section class="section section--alt" data-reveal>
    <div class="container">
      <div class="section__head">
        <div class="section__head__text">
          <div class="section__kicker">News</div>
          <h2 class="section__title">{u.home_news_title}</h2>
          <p class="section__desc">{u.home_news_desc}</p>
        </div>
        <a href={navHref(L, '/news')} class="btn btn--ghost">{u.viewAll}</a>
      </div>
      <div class="grid grid--3">
        {recentNews.map((n) => <NewsCard news={n} lang={L} />)}
      </div>
    </div>
  </section>

  <!-- ===== 团队成员 ===== -->
  <section class="section" data-reveal>
    <div class="container">
      <div class="section__head">
        <div class="section__head__text">
          <div class="section__kicker">People</div>
          <h2 class="section__title">{u.home_people_title}</h2>
        </div>
        <a href={navHref(L, '/people')} class="btn btn--ghost">{u.viewAll}</a>
      </div>
      <div class="grid grid--4">
        {featuredPeople.map((p) => <PeopleCard person={p} lang={L} />)}
      </div>
    </div>
  </section>

  <!-- ===== 合作伙伴 ===== -->
  <section class="section section--alt" data-reveal>
    <div class="container">
      <div class="section__head">
        <div class="section__head__text">
          <div class="section__kicker">Partners</div>
          <h2 class="section__title">{u.home_partners_title}</h2>
        </div>
      </div>
      <div class="grid grid--4">
        {partners.map((p) => <PartnerCard partner={p} lang={L} />)}
      </div>
    </div>
  </section>
</Layout>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero__slide'));
  if (slides.length > 1) {
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, 10000);
  }
</script>

<script>
  const input = document.getElementById('siteSearchInput');
  const results = document.getElementById('siteSearchResults');
  const dataEl = document.getElementById('searchIndexData');
  if (input && results && dataEl) {
    let index = [];
    try { index = JSON.parse(dataEl.textContent || '[]'); } catch (e) { index = []; }
    const emptyText = input.getAttribute('data-empty') || '未找到相关结果';

    const close = () => { results.innerHTML = ''; results.hidden = true; };
    const render = (q) => {
      const query = (q || '').trim().toLowerCase();
      if (!query) { close(); return; }
      const matches = index
        .filter((it) => (it.title + ' ' + (it.desc || '') + ' ' + it.typeLabel).toLowerCase().indexOf(query) !== -1)
        .slice(0, 8);
      if (matches.length === 0) {
        results.innerHTML = '<li class="site-search__empty">' + emptyText + '</li>';
      } else {
        results.innerHTML = matches.map((m) =>
          '<li><a href="' + m.url + '" class="site-search__item">' +
            '<span class="site-search__type">' + m.typeLabel + '</span>' +
            '<span class="site-search__title">' + m.title + '</span>' +
            '<span class="site-search__desc">' + (m.desc || '') + '</span>' +
          '</a></li>'
        ).join('');
      }
      results.hidden = false;
    };

    input.addEventListener('input', (e) => render(e.target.value));
    input.addEventListener('focus', (e) => render(e.target.value));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const first = results.querySelector('a');
        if (first) window.location.href = first.getAttribute('href') || '';
      }
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.site-search')) close();
    });
  }
</script>

<script>
  // 滚动揭示动画：进入视口时淡入上移
  document.documentElement.classList.add('js');
  const revealEls = Array.from(document.querySelectorAll('[data-reveal]'));
  if ('IntersectionObserver' in window && revealEls.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  }
</script>
<style>
  .hero {
    position: relative;
    background:
      radial-gradient(1000px 500px at 85% -10%, rgba(202, 138, 4, 0.25), transparent 60%),
      radial-gradient(900px 500px at -10% 110%, rgba(47, 125, 70, 0.35), transparent 60%),
      linear-gradient(135deg, #0d3b20 0%, #14532d 55%, #1c6b3a 100%);
    color: #fff;
    padding: 96px 0 72px;
    overflow: hidden;
  }
  .hero__inner {
    max-width: 760px;
  }
  .hero__org {
    display: inline-block;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #fcd34d;
    margin-bottom: 18px;
  }
  .hero__title {
    color: #fff;
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.15;
    margin-bottom: 20px;
    font-family: var(--font-serif);
  }
  .hero__sub {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.75;
    margin-bottom: 32px;
    max-width: 640px;
  }
  .hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 36px;
    margin-top: 44px;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .hero__stat {
    display: flex;
    flex-direction: column;
  }
  .hero__stat-num {
    font-size: 30px;
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
  }
  .hero__stat-label {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.78);
    margin-top: 4px;
  }
  .hero__ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
  }
  .hero__ghost:hover {
    background: #fff;
    color: var(--color-primary);
  }

 /* —— 背景轮播 —— */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(13, 59, 32, 0.78), rgba(20, 83, 45, 0.62));
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 1.6s ease, transform 9s ease;
  }
  .hero__slide.is-active {
    opacity: 1;
    transform: scale(1);
  }
  .hero > .container {
    position: relative;
    z-index: 1;
  }
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .about__body {
    background: linear-gradient(165deg, #ffffff 0%, #f1f8f3 100%);
    border: 1px solid rgba(20, 83, 45, 0.16);
    border-top: 4px solid var(--color-primary);
    border-radius: var(--radius);
    padding: 28px;
    color: var(--color-text-muted);
    font-size: 15.5px;
    box-shadow: 0 20px 45px -20px rgba(13, 59, 32, 0.38), 0 2px 8px rgba(13, 59, 32, 0.06);
  }
  .site-search {
    position: relative;
  }
  .site-search__icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: var(--color-primary);
    pointer-events: none;
  }
  .site-search__input {
    width: 100%;
    box-sizing: border-box;
    font-size: 16px;
    padding: 16px 18px 16px 46px;
    border: 1.5px solid rgba(20, 83, 45, 0.35);
    border-radius: 12px;
    background: #fff;
    color: var(--color-text);
    outline: none;
    box-shadow: inset 0 1px 3px rgba(13, 59, 32, 0.07), 0 1px 2px rgba(13, 59, 32, 0.05);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .site-search__input::placeholder {
    color: #9aa39d;
  }
  .site-search__input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px rgba(20, 83, 45, 0.15), inset 0 1px 3px rgba(13, 59, 32, 0.07);
  }
  .site-search__results {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 8px);
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    z-index: 20;
    max-height: 360px;
    overflow-y: auto;
  }
  .site-search__item {
    display: block;
    padding: 10px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-text);
    transition: background 0.15s ease;
  }
  .site-search__item:hover {
    background: rgba(20, 83, 45, 0.08);
  }
  .site-search__type {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    background: var(--color-primary);
    padding: 2px 8px;
    border-radius: 999px;
    margin-right: 8px;
  }
  .site-search__title {
    font-weight: 600;
  }
  .site-search__desc {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .site-search__empty {
    padding: 14px;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .section__more {
    margin-top: 28px;
    text-align: center;
  }
  .news-list {
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 720px) {
    .about {
      grid-template-columns: 1fr;
    }
    .hero {
      padding: 64px 0 96px;
    }
    .hero__stats {
      gap: 20px;
      margin-top: 32px;
      padding-top: 22px;
    }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { lab, t } from '../../i18n/ui';
import { isLang } from '../../i18n/utils';
import PageHero from '../../components/PageHero.astro';
import EquipmentCard from '../../components/EquipmentCard.astro';

export async function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const L = isLang(lang) ? lang : 'zh';
const isZh = L === 'zh';
const u = t(L);

const equipment = await getCollection('equipment');
equipment.sort((a, b) => a.data.order - b.data.order);

const title = isZh ? lab.name_zh : lab.name_en;
---

<!--
  注意：本页面【有意不加入导航菜单】（navItems 中没有 equipment 条目）。
  访客通过首页搜索框搜索「仪器设备 / 设备 / equipment」进入，
  搜索入口在 src/pages/[lang]/index.astro 的 searchIndex 中登记。
  想让它出现在导航里：在 src/i18n/ui.ts 的 navItems 中加回 equipment 条目即可。
-->
<Layout lang={L} title={u.equipment_title} description={u.equipment_desc}>
  <PageHero kicker={title} title={u.equipment_title} desc={u.equipment_desc} />

  <section class="section">
    <div class="container">
      {equipment.length > 0 ? (
        <div class="grid grid--3">
          {equipment.map((item) => <EquipmentCard item={item} lang={L} />)}
        </div>
      ) : (
        <p class="empty">{isZh ? '暂无设备信息。' : 'No equipment yet.'}</p>
      )}
    </div>
  </section>
</Layout>

<style>
  .empty {
    color: var(--color-text-muted);
    text-align: center;
    padding: 60px 0;
  }
</style>

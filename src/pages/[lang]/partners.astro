---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { lab, t } from '../../i18n/ui';
import { isLang } from '../../i18n/utils';
import PageHero from '../../components/PageHero.astro';
import PartnerCard from '../../components/PartnerCard.astro';

export async function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const L = isLang(lang) ? lang : 'zh';
const isZh = L === 'zh';
const u = t(L);

const partners = await getCollection('partners');
partners.sort((a, b) => a.data.order - b.data.order);

const title = isZh ? lab.name_zh : lab.name_en;
---

<Layout lang={L} title={u.partners_title} description={u.partners_desc} active="partners">
  <PageHero kicker={title} title={u.partners_title} desc={u.partners_desc} />

  <section class="section">
    <div class="container">
      <div class="grid grid--4">
        {partners.map((p) => <PartnerCard partner={p} lang={L} />)}
      </div>
    </div>
  </section>
</Layout>

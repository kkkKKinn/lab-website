---
import { asset } from '../i18n/utils';

interface Props {
  kicker?: string;
  title: string;
  desc?: string;
  /** 顶部背景图路径（以 '/' 开头，如 '/images/page-people.jpg'）；不传则用纯色渐变 */
  bg?: string;
}

const { kicker, title, desc, bg } = Astro.props;
const bgUrl = bg ? asset(bg) : '';
---

<div
  class:list={['page-hero', { 'page-hero--with-bg': !!bgUrl }]}
  style={bgUrl ? `--page-hero-bg: url('${bgUrl}')` : undefined}
>
  <div class="container">
    {kicker && <div class="section__kicker">{kicker}</div>}
    <h1 class="page-hero__title">{title}</h1>
    {desc && <p class="page-hero__desc">{desc}</p>}
  </div>
</div>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--color-primary) 0%, #0d3b20 100%);
    color: #fff;
    /* 原来只有 padding: 64px 0，横幅高约 230px，显得又窄又薄；
       改用 min-height + 垂直居中，横幅拉高，背景图展示更充分 */
    min-height: 360px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 0;
  }
  /* 手机上不要占满整屏，适当收低 */
  @media (max-width: 720px) {
    .page-hero {
      min-height: 240px;
      padding: 56px 0;
    }
  }
  /* 传入背景图时：照片 + 深色遮罩，叠在纯色兜底之上（图片缺失也不会露白） */
  .page-hero--with-bg {
    background:
      linear-gradient(180deg, rgba(5, 16, 10, 0.78) 0%, rgba(5, 16, 10, 0.66) 100%),
      var(--page-hero-bg, none) center / cover no-repeat,
      linear-gradient(180deg, var(--color-primary) 0%, #0d3b20 100%);
  }
  .page-hero :global(.section__kicker) {
    color: #fcd34d;
  }
  .page-hero :global(.section__kicker)::before {
    background: #fcd34d;
  }
  .page-hero__title {
    font-size: clamp(30px, 4vw, 42px);
    color: #fff;
  }
  .page-hero__desc {
    margin-top: 12px;
    max-width: 680px;
    font-size: 17px;
    color: rgba(255, 255, 255, 0.82);
  }
</style>

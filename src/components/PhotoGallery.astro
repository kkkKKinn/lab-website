---
import { asset } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface GalleryImage {
  src: string;
  caption_zh: string;
  caption_en: string;
}

interface Props {
  images: GalleryImage[];
  lang: Lang;
}

const { images, lang } = Astro.props;
const isZh = lang === 'zh';
const cap = (img: GalleryImage) => (isZh ? img.caption_zh : img.caption_en);

const n = images.length;

/** 计算某张图在「封面流」中的位置样式（active 为当前居中图的下标） */
function styleFor(i: number, active: number) {
  let d = i - active;
  if (d > n / 2) d -= n;
  if (d < -n / 2) d += n;
  const abs = Math.abs(d);
  const scale = d === 0 ? 1 : abs >= 2 ? 0.6 : 0.8;
  const blur = d === 0 ? 0 : abs >= 2 ? 8 : 4;
  const opacity = d === 0 ? 1 : abs >= 2 ? 0 : 0.55;
  const tx = d * 58;
  const z = d === 0 ? 30 : Math.max(1, 20 - abs * 5);
  return {
    transform: `translate(-50%, -50%) translateX(${tx}%) scale(${scale})`,
    filter: blur ? `blur(${blur}px)` : 'none',
    opacity: String(opacity),
    zIndex: String(z),
    pointerEvents: abs <= 1 ? 'auto' : 'none',
    cursor: d === 0 ? 'zoom-in' : 'pointer',
  };
}

const items = images.map((img, i) => {
  const s = styleFor(i, 0);
  const styleStr = Object.entries(s)
    .map(([k, v]) => `${k}:${v}`)
    .join(';');
  return { img, cap: cap(img), style: styleStr };
});
---

<div class="coverflow" tabindex="0" aria-roledescription="carousel">
  <div class="coverflow__stage">
    <button class="cf-nav cf-prev" type="button" aria-label={isZh ? '上一张' : 'Previous'}>‹</button>
    {items.map((it) => (
      <figure class="cf-item" data-caption={it.cap} style={it.style}>
        <img src={asset(it.img.src)} alt={it.cap} loading="lazy" decoding="async" />
      </figure>
    ))}
    <button class="cf-nav cf-next" type="button" aria-label={isZh ? '下一张' : 'Next'}>›</button>
  </div>
  <div class="coverflow__caption">{items[0]?.cap}</div>
  <div class="coverflow__dots">
    {items.map((_, i) => (
      <button class:list={['dot', { 'is-active': i === 0 }]} type="button" data-go={i} aria-label={`${i + 1}`}></button>
    ))}
  </div>
</div>

<!-- 点击中间照片后的放大预览层 -->
<div class="gallery__lightbox" id="galleryLightbox" hidden>
  <button class="gallery__close" type="button" aria-label={isZh ? '关闭' : 'Close'}>×</button>
  <img class="gallery__lightbox-img" src="" alt="" />
  <p class="gallery__lightbox-caption"></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.coverflow');
  const lb = document.getElementById('galleryLightbox');

  // 灯箱必须挂到 body 下：所在 section 的入场动画会带 transform，
  // 那会让 position:fixed 的包含块变成该 section，灯箱就无法覆盖整个视口。
  if (lb && lb.parentElement !== document.body) {
    document.body.appendChild(lb);
  }

  if (root) {
    const figs = Array.from(root.querySelectorAll<HTMLElement>('.cf-item'));
    const captionEl = root.querySelector<HTMLElement>('.coverflow__caption')!;
    const dots = root.querySelector<HTMLElement>('.coverflow__dots')!;
    const n = figs.length;
    let active = 0;

    const lbImg = lb?.querySelector<HTMLImageElement>('.gallery__lightbox-img') ?? null;
    const lbCap = lb?.querySelector<HTMLElement>('.gallery__lightbox-caption') ?? null;

    function apply(item: HTMLElement, i: number) {
      let d = i - active;
      if (d > n / 2) d -= n;
      if (d < -n / 2) d += n;
      const abs = Math.abs(d);
      const scale = d === 0 ? 1 : abs >= 2 ? 0.6 : 0.8;
      const blur = d === 0 ? 0 : abs >= 2 ? 8 : 4;
      const opacity = d === 0 ? 1 : abs >= 2 ? 0 : 0.55;
      const tx = d * 58;
      item.style.transform = `translate(-50%, -50%) translateX(${tx}%) scale(${scale})`;
      item.style.filter = blur ? `blur(${blur}px)` : 'none';
      item.style.opacity = String(opacity);
      item.style.zIndex = String(d === 0 ? 30 : Math.max(1, 20 - abs * 5));
      item.style.pointerEvents = abs <= 1 ? 'auto' : 'none';
      item.style.cursor = d === 0 ? 'zoom-in' : 'pointer';
      item.classList.toggle('is-active', d === 0);
    }

    function render() {
      figs.forEach((fig, i) => apply(fig, i));
      dots.querySelectorAll<HTMLElement>('.dot').forEach((dot, i) => dot.classList.toggle('is-active', i === active));
      const cap = figs[active]?.querySelector('img')?.alt;
      if (cap) captionEl.textContent = cap;
    }

    function go(i: number) {
      active = ((i % n) + n) % n;
      render();
    }

    function openLightbox(fig: HTMLElement) {
      const img = fig.querySelector<HTMLImageElement>('img');
      if (lbImg && img) {
        lbImg.src = img.currentSrc || img.src;
        lbImg.alt = img.alt;
      }
      if (lbCap) lbCap.textContent = fig.dataset.caption || '';
      if (lb) {
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (!lb) return;
      lb.hidden = true;
      document.body.style.overflow = '';
    }

    root.querySelector('.cf-prev')?.addEventListener('click', () => go(active - 1));
    root.querySelector('.cf-next')?.addEventListener('click', () => go(active + 1));
    dots.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.dot');
      if (btn) go(Number(btn.dataset.go));
    });
    figs.forEach((fig, i) => {
      fig.addEventListener('click', () => {
        if (i === active) openLightbox(fig);
        else go(i);
      });
    });

    // 手机 / 触屏：左右滑动切换
    let swipeStartX: number | null = null;
    root.addEventListener(
      'touchstart',
      (e) => {
        swipeStartX = e.touches[0]?.clientX ?? null;
      },
      { passive: true }
    );
    root.addEventListener(
      'touchend',
      (e) => {
        if (swipeStartX === null) return;
        const endX = e.changedTouches[0]?.clientX ?? swipeStartX;
        const dx = endX - swipeStartX;
        swipeStartX = null;
        if (Math.abs(dx) < 40) return;
        if (dx < 0) go(active + 1);
        else go(active - 1);
      },
      { passive: true }
    );

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const t = e.target as HTMLElement | null;
      if (t && t.closest && t.closest('input, textarea')) return;
      if (lb && !lb.hidden) return;
      if (e.key === 'ArrowLeft') go(active - 1);
      else go(active + 1);
    });

    if (lb) {
      lb.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target === lb || target.classList.contains('gallery__close')) closeLightbox();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lb.hidden) closeLightbox();
      });
    }

    render();
  }
</script>

<style>
  .coverflow {
    /* 裁掉两侧虚化图越界的部分，避免窄屏出现横向滚动条 */
    overflow: hidden;
    outline: none;
    user-select: none;
  }
  .coverflow__stage {
    position: relative;
    width: 100%;
    max-width: 920px;
    height: 440px;
    margin: 0 auto;
  }
  .cf-item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60%;
    height: 100%;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    transform-origin: center;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.55s ease, filter 0.55s ease;
    background: var(--color-primary-light);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow);
    will-change: transform, opacity, filter;
  }
  .cf-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .cf-item.is-active {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
  }
  .cf-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    width: 46px;
    height: 46px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-primary);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .cf-nav:hover {
    background: #fff;
    transform: translateY(-50%) scale(1.08);
  }
  .cf-prev {
    left: 4px;
  }
  .cf-next {
    right: 4px;
  }
  .coverflow__caption {
    text-align: center;
    margin-top: var(--space-3);
    min-height: 22px;
    font-size: 14.5px;
    color: var(--color-text-muted);
  }
  .coverflow__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: var(--space-2);
  }
  .dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-border);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .dot.is-active {
    background: var(--color-primary);
    transform: scale(1.3);
  }

  /* 放大预览（沿用原样式） */
  .gallery__lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    align-content: center;
    padding: var(--space-4);
    background: rgba(8, 24, 14, 0.88);
    backdrop-filter: blur(4px);
    cursor: zoom-out;
  }
  .gallery__lightbox[hidden] {
    display: none;
  }
  .gallery__lightbox-img {
    max-width: 92vw;
    max-height: 78vh;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
  }
  .gallery__lightbox-caption {
    margin-top: var(--space-2);
    color: #dce9e1;
    font-size: 14.5px;
    text-align: center;
  }
  .gallery__close {
    position: absolute;
    top: 20px;
    right: 24px;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .gallery__close:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 960px) {
    .coverflow__stage {
      height: 380px;
    }
  }

  @media (max-width: 720px) {
    .coverflow__stage {
      height: 300px;
    }
    .cf-item {
      width: 74%;
    }
    .cf-nav {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }
  }
</style>

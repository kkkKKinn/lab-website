---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n/ui';

interface Props {
  paper: CollectionEntry<'papers'>;
  lang: Lang;
  showAbstract?: boolean;
}

const { paper, lang, showAbstract = false } = Astro.props;
const d = paper.data;
const isZh = lang === 'zh';
const title = isZh ? d.title_zh : d.title_en;
const abstract = isZh ? d.abstract_zh : d.abstract_en;
const typeLabel: Record<string, { zh: string; en: string }> = {
  journal: { zh: '期刊论文', en: 'Journal' },
  conference: { zh: '会议论文', en: 'Conference' },
  patent: { zh: '专利', en: 'Patent' },
  other: { zh: '其他', en: 'Other' },
};
const typeTag = typeLabel[d.type][lang];
---

<article class="paper-item">
  <div class="paper-item__row">
    <h3 class="paper-item__title">{title}</h3>
    <span class="tag">{typeTag}</span>
  </div>
  <div class="paper-item__meta">
    <span class="paper-item__authors">{d.authors}</span>
    <span class="paper-item__venue">{d.venue}</span>
    <span class="paper-item__year">{d.year}</span>
  </div>
  {showAbstract && abstract && (
    <p class="paper-item__abstract">{abstract}</p>
  )}
  <div class="paper-item__links">
    {d.doi && (
      <a href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener" class="paper-item__link">
        {t(lang).pub_doi}
      </a>
    )}
    {d.pdf && (
      <a href={d.pdf} target="_blank" rel="noopener" class="paper-item__link">
        {t(lang).pub_pdf}
      </a>
    )}
  </div>
</article>

<style>
  .paper-item {
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .paper-item__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .paper-item__title {
    font-size: 17px;
    font-weight: 600;
    color: #0f172a;
    margin-bottom: 6px;
  }
  .paper-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 14px;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }
  .paper-item__authors {
    font-style: italic;
  }
  .paper-item__venue {
    font-weight: 500;
  }
  .paper-item__year {
    color: var(--color-accent);
    font-weight: 600;
  }
  .paper-item__abstract {
    color: var(--color-text-muted);
    font-size: 14.5px;
    margin: 8px 0;
  }
  .paper-item__links {
    display: flex;
    gap: 16px;
  }
  .paper-item__link {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>

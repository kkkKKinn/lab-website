---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';

interface Props {
  direction: CollectionEntry<'directions'>;
  lang: Lang;
  index: number;
}

const { direction, lang, index } = Astro.props;
const d = direction.data;
const isZh = lang === 'zh';
const name = isZh ? d.name_zh : d.name_en;
const desc = isZh ? d.desc_zh : d.desc_en;
const detail = isZh ? d.detail_zh : d.detail_en;
const points = isZh ? d.points_zh : d.points_en;
// 视觉序号：01 / 02 …
const num = String(index + 1).padStart(2, '0');
---

<article class="card direction-card">
  <span class="direction-card__num" aria-hidden="true">{num}</span>
  <h3 class="direction-card__name">{name}</h3>
  <p class="direction-card__desc">{desc}</p>
  {detail && <p class="direction-card__detail">{detail}</p>}
  {points.length > 0 && (
    <ul class="direction-card__points">
      {points.map((p) => <li>{p}</li>)}
    </ul>
  )}
</article>

<style>
  .direction-card {
    position: relative;
    overflow: hidden;
    padding-top: 26px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  /* 顶部色条 + 右上角大号序号，强调「方向」的视觉层级 */
  .direction-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), #2f7d46);
  }
  .direction-card__num {
    position: absolute;
    top: 16px;
    right: 20px;
    font-size: 32px;
    font-weight: 800;
    line-height: 1;
    font-family: var(--font-serif);
    color: var(--color-primary);
    opacity: 0.16;
  }
  .direction-card__name {
    font-size: 18px;
    margin-bottom: 10px;
    padding-right: 44px;
  }
  .direction-card__desc {
    color: var(--color-text-muted);
    font-size: 14.5px;
  }
  .direction-card__detail {
    color: var(--color-text-muted);
    font-size: 14px;
    margin-top: 8px;
  }
  .direction-card__points {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .direction-card__points li {
    font-size: 12.5px;
    line-height: 1.4;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(20, 83, 45, 0.08);
    border: 1px solid rgba(20, 83, 45, 0.14);
    color: var(--color-primary);
  }
  .direction-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
</style>

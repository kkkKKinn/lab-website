---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { asset } from '../i18n/utils';

interface Props {
  partner: CollectionEntry<'partners'>;
  lang: Lang;
}

const { partner, lang } = Astro.props;
const d = partner.data;
const isZh = lang === 'zh';
const name = isZh ? d.name_zh : d.name_en;
const desc = isZh ? d.desc_zh : d.desc_en;
const initial = name.charAt(0);
---

<article class="card partner-card">
  <div class="partner-card__logo">
    {d.logo ? (
      <img src={asset(d.logo)} alt={name} loading="lazy" />
    ) : (
      <span class="partner-card__initial">{initial}</span>
    )}
  </div>
  <h3 class="partner-card__name">{name}</h3>
  {desc && <p class="partner-card__desc">{desc}</p>}
  {d.url && (
    <a href={d.url} target="_blank" rel="noopener" class="partner-card__link">
      ↗
    </a>
  )}
</article>

<style>
  .partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 28px 20px;
  }
  .partner-card__logo {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    background: var(--color-primary-light);
    display: grid;
    place-items: center;
    margin-bottom: 14px;
    overflow: hidden;
  }
  .partner-card__logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .partner-card__initial {
    font-size: 26px;
    font-weight: 700;
    color: var(--color-primary);
  }
  .partner-card__name {
    font-size: 16px;
    margin-bottom: 6px;
  }
  .partner-card__desc {
    color: var(--color-text-muted);
    font-size: 13.5px;
    margin-bottom: 10px;
  }
  .partner-card__link {
    font-size: 18px;
    font-weight: 700;
  }
</style>

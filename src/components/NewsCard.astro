---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { BASE } from '../i18n/utils';

interface Props {
  news: CollectionEntry<'news'>;
  lang: Lang;
}

const { news, lang } = Astro.props;
const d = news.data;
const isZh = lang === 'zh';
const title = isZh ? d.title_zh : d.title_en;
const summary = isZh ? d.summary_zh : d.summary_en;
const dateStr = d.date.toLocaleDateString(isZh ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const href = `${BASE}${lang}/news/${news.id.replace(/\.md$/, '')}/`;
---

<article class="news-card">
  <div class="news-card__date">
    <span class="news-card__day">{d.date.getDate()}</span>
    <span class="news-card__month">
      {d.date.toLocaleDateString(isZh ? 'zh-CN' : 'en-US', { month: 'short' })}
      {' '}{d.date.getFullYear()}
    </span>
  </div>
  <div class="news-card__content">
    <h3 class="news-card__title">
      <a href={href}>{title}</a>
    </h3>
    {summary && <p class="news-card__summary">{summary}</p>}
  </div>
</article>

<style>
  .news-card {
    display: flex;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .news-card__date {
    width: 64px;
    flex-shrink: 0;
    text-align: center;
    background: var(--color-primary-light);
    border-radius: 12px;
    padding: 10px 8px;
    height: fit-content;
  }
  .news-card__day {
    display: block;
    font-size: 24px;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }
  .news-card__month {
    font-size: 12px;
    color: var(--color-primary);
    font-weight: 600;
  }
  .news-card__title {
    font-size: 18px;
    margin-bottom: 6px;
  }
  .news-card__title a {
    color: #0f172a;
  }
  .news-card__title a:hover {
    color: var(--color-primary);
  }
  .news-card__summary {
    color: var(--color-text-muted);
    font-size: 14.5px;
  }
</style>

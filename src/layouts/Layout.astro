---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { lab, type Lang } from '../i18n/ui';
import { BASE } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** 当前激活的导航 key */
  active?: string;
}

const { lang, title, description, active } = Astro.props;
const siteTitle = `${title} · ${lab[lang === 'zh' ? 'short_zh' : 'short_en']}`;
const pageDesc = description || siteTitle;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header lang={lang} active={active} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // 移动端导航开关
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.querySelector('.nav');
      toggle?.addEventListener('click', () => nav?.classList.toggle('is-open'));
    </script>
  </body>
</html>
